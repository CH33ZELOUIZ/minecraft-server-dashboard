# Copy to .env and edit for your server.
DASHBOARD_PORT=3011
MINECRAFT_CONTAINER=minecraft-server
MINECRAFT_DATA_PATH=./minecraft-data
# Default 1 restricts API/WebSocket access to private/LAN/Tailscale-style client IPs.
# Set to 0 only if you put this behind real authentication/reverse proxy access controls.
API_ALLOW_PRIVATE_ONLY=1
